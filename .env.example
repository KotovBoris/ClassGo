# ============================================================
#  ClassGo — пример переменных окружения
#  Скопируйте в .env и заполните. РАБОЧИЕ СЕКРЕТЫ В GIT НЕ ПОПАДАЮТ.
#  (Файл .env уже добавлен в .gitignore)
# ============================================================

# --- MAX Bot API ---
# Токен чат-бота, выданный платформой MAX (раздел «Чат-боты» → Настройки).
# Без токена бот не запускается; REST API и мини-приложение работают.
MAX_BOT_TOKEN=

# Актуальный домен API MAX по документации dev.max.ru
MAX_API_BASE=https://platform-api2.max.ru

# Режим получения обновлений: polling | webhook | off
#   polling — long polling (для локальной разработки и демонстрации)
#   webhook — приём обновлений на MAX_WEBHOOK_URL (production)
#   off     — бот выключен (проверка только REST/mini-app)
MAX_BOT_MODE=polling

# Ник бота в MAX (нужен для диплинков и кнопки open_app).
# Ник бота после создания в MAX не меняется.
MAX_BOT_USERNAME=t158_hakaton_max_bot

# Только для MAX_BOT_MODE=webhook: публичный HTTPS-адрес эндпоинта /webhook/max
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

# --- TLS до MAX (сертификаты Минцифры) ---
# Контейнеру не доверяет корневым CA Минцифры. Файл certs/ca-bundle.pem уже
# подготовлен в репозитории и монтируется в контейнер как /certs/ca-bundle.pem.
MAX_CA_BUNDLE=/certs/ca-bundle.pem
# Альтернатива для локальной демонстрации (НЕ для прода): отключить проверку TLS.
MAX_TLS_INSECURE=0

# --- Приложение ---
# SQLite на хакатоне: ноль настройки, воспроизводимость
DATABASE_URL=sqlite:////app/data/classgo.db

# --- PostgreSQL (опционально) ---
# Чтобы переключиться на PostgreSQL:
#   1) раскомментируйте DATABASE_URL ниже (или впишите свой хост/пароль)
#   2) запустите: docker compose --profile postgres up -d --build
# DATABASE_URL=postgresql+psycopg2://classgo:classgo@db:5432/classgo
POSTGRES_DB=classgo
POSTGRES_USER=classgo
POSTGRES_PASSWORD=classgo

# Публичные адреса (для абсолютных ссылок на файлы приказа)
MINIAPP_BASE_URL=http://localhost:8080
PUBLIC_BASE_URL=http://localhost:8080

# Автосоздание схемы и сидирование демонстрационных данных при старте
AUTO_SEED=true
LOG_LEVEL=INFO
